generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  kiteAccessToken String?
  kiteUserId      String?

  strategies     Strategy[]
  paperPortfolio PaperPortfolio?
  orders         Order[]
  watchlists     Watchlist[]
}

model Strategy {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        StrategyType
  config      Json
  isActive    Boolean  @default(false)
  isPaper     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]
}

enum StrategyType {
  SMA_CROSSOVER
  EMA_CROSSOVER
  RSI
  MACD
  BOLLINGER_BANDS
  VWAP
  SUPERTREND
  CUSTOM
}

model PaperPortfolio {
  id           String  @id @default(cuid())
  balance      Float   @default(1000000)
  initialBalance Float @default(1000000)
  totalPnL     Float   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  holdings PaperHolding[]
  trades   PaperTrade[]
}

model PaperHolding {
  id            String @id @default(cuid())
  symbol        String
  exchange      String @default("NSE")
  quantity      Int
  avgPrice      Float
  currentPrice  Float  @default(0)
  pnl           Float  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  portfolioId String
  portfolio   PaperPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model PaperTrade {
  id         String    @id @default(cuid())
  symbol     String
  exchange   String    @default("NSE")
  side       OrderSide
  quantity   Int
  price      Float
  total      Float
  executedAt DateTime  @default(now())

  portfolioId String
  portfolio   PaperPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(cuid())
  symbol        String
  exchange      String      @default("NSE")
  side          OrderSide
  orderType     OrderType   @default(MARKET)
  quantity      Int
  price         Float?
  triggerPrice  Float?
  status        OrderStatus @default(PENDING)
  kiteOrderId   String?
  isPaper       Boolean     @default(true)
  executedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId String?
  strategy   Strategy? @relation(fields: [strategyId], references: [id])
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  SL
  SL_M
}

enum OrderStatus {
  PENDING
  PLACED
  EXECUTED
  CANCELLED
  REJECTED
  EXPIRED
}

model Watchlist {
  id        String   @id @default(cuid())
  name      String
  symbols   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── SmartAlgo-aligned market data & backtests (optional when DATABASE_URL set) ──

model SymbolMaster {
  id              String   @id @default(cuid())
  exchange        String
  symbol          String
  companyName     String?
  instrumentToken String?
  lotSize         Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([exchange, symbol])
}

model Candle {
  id        String   @id @default(cuid())
  symbol    String
  exchange  String   @default("NSE")
  timeframe String
  timestamp DateTime
  open      Decimal  @db.Decimal(12, 4)
  high      Decimal  @db.Decimal(12, 4)
  low       Decimal  @db.Decimal(12, 4)
  close     Decimal  @db.Decimal(12, 4)
  volume    Decimal  @db.Decimal(18, 2)
  source    String   @default("yahoo")
  createdAt DateTime @default(now())

  @@unique([symbol, exchange, timeframe, timestamp], name: "symbol_exchange_timeframe_timestamp")
  @@index([symbol, timeframe, timestamp])
}

model BacktestRun {
  id              String   @id @default(cuid())
  strategyId      String
  symbol          String
  exchange        String   @default("NSE")
  timeframe       String   @default("Day")
  startDate       DateTime
  endDate         DateTime
  initialCapital  Decimal  @db.Decimal(14, 2)
  finalCapital    Decimal  @db.Decimal(14, 2)
  totalReturnPct  Decimal  @db.Decimal(10, 4)
  winRate         Decimal  @db.Decimal(10, 4)
  profitFactor    Decimal  @db.Decimal(10, 4)
  maxDrawdownPct  Decimal  @db.Decimal(10, 4)
  sharpeRatio     Decimal  @db.Decimal(10, 4)
  reportJson      Json
  createdAt       DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(cuid())
  severity  String
  source    String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RiskCheck {
  id         String   @id @default(cuid())
  symbol     String
  strategyId String?
  approved   Boolean
  reason     String?
  payload    Json?
  createdAt  DateTime @default(now())
}
