# Database (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/algo_trader?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Zerodha Kite Connect
KITE_API_KEY="your-kite-api-key"
KITE_API_SECRET="your-kite-api-secret"
KITE_ACCESS_TOKEN=""

# Paper Trading Defaults
PAPER_TRADING_INITIAL_BALANCE=1000000

# Email notifications (paper + live orders)
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=

# Server-side strategy cron (Vercel env + GitHub Actions secret CRON_SECRET for 15-min scans)
# Run in terminal: openssl rand -base64 32
# Paste the OUTPUT (e.g. K7x9abc...) — NOT the words "openssl rand -base64 32"
CRON_SECRET=
# Firebase Console → Project Settings → Service accounts → Generate new private key (paste full JSON on one line)
FIREBASE_SERVICE_ACCOUNT_JSON=
